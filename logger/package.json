{
  "name": "droonialarm-sitrep-logger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create droonialarm-sitrep",
    "db:migrate": "wrangler d1 execute droonialarm-sitrep --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute droonialarm-sitrep --local --file=./schema.sql",
    "db:console": "wrangler d1 execute droonialarm-sitrep --remote --command=\"select count(*) from observations\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.59.0"
  }
}
